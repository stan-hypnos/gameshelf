{
  "name": "gameshelf",
  "productName": "GameShelf",
  "version": "1.0.0",
  "private": true,
  "description": "极简个人游戏记录管理器",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^38.0.0",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "electron-builder": "^24.13.3",
    "playwright-core": "^1.48.0"
  },
  "build": {
    "appId": "com.gameshelf.desktop",
    "productName": "GameShelf",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
